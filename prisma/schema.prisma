generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  // Encrypted PHI fields (AES-256-GCM via phi-crypto.ts)
  email        String?  // encrypted ciphertext
  phone        String?  // encrypted ciphertext
  name         String   @default("") // encrypted ciphertext
  dob          String?  // encrypted ciphertext (stored as ISO string)
  // Deterministic HMAC-SHA256 hashes for DB lookups (never decrypt — lookup only)
  emailHash    String?  @unique
  phoneHash    String?  @unique
  passwordHash String   @default("")
  gender                 String?
  timeZone               String?
  emailVerified          Boolean   @default(false)
  emailVerificationToken String?
  emailVerificationExpiry DateTime?
  pushToken              String?   // Expo push token for native notifications
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  profile       Profile?
  metrics       Metric[]
  goals         Goal[]
  devices       Device[]
  consents      Consent[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  rating        Rating?
  workouts      Workout[]
  notifications Notification[]
  subscription  Subscription?
}

model Profile {
  id             String  @id @default(uuid())
  userId         String  @unique
  height         Float?
  baselineWeight Float?
  bloodType      String?
  medicalNotes   String?
  avatarUrl      String? // base64 data URI or external URL

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Metric {
  id        String   @id @default(uuid())
  userId    String
  type      String
  value     Float
  unit      String
  timestamp DateTime
  source    String   @default("manual")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id           String   @id @default(uuid())
  userId       String
  metricType   String
  targetValue  Float
  currentValue Float?
  startDate    DateTime
  endDate      DateTime
  recurrence   String   @default("none")
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Device {
  id       String   @id @default(uuid())
  userId   String
  vendor   String
  model    String
  lastSync DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Consent {
  id             String    @id @default(uuid())
  userId         String
  providerId     String
  scope          String
  purpose        String    @default("health_tracking")
  dataCategories String[]  @default([])
  grantedAt      DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  timestamp DateTime @default(now())
  metadata  Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workout {
  id           String    @id @default(uuid())
  userId       String
  name         String
  category     String
  emoji        String    @default("🏋️")
  exercises    Json      // Exercise[]
  durationMins Int
  caloriesBurned Int     @default(0)
  scheduledAt  DateTime
  completedAt  DateTime?
  status       String    @default("scheduled") // scheduled | completed | skipped
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Rating {
  id        String   @id @default(uuid())
  userId    String   @unique
  stars     Int      // 1–5
  review    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // 'reminder' | 'summary' | 'goal' | 'streak' | 'system'
  title     String
  body      String
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model Subscription {
  id          String   @id @default(uuid())
  userId      String   @unique
  plan        String   // 'trial' | 'monthly' | 'yearly'
  status      String   @default("active") // 'active' | 'expired' | 'cancelled'
  startedAt   DateTime @default(now())
  expiresAt   DateTime
  // For weekly plan rotation — which week variant the user is on
  planWeekOffset Int   @default(0)
  // Streak tracking
  currentStreak  Int   @default(0)
  longestStreak  Int   @default(0)
  lastCheckinAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkins    WeeklyCheckin[]
}

model WeeklyCheckin {
  id             String   @id @default(uuid())
  userId         String
  subscriptionId String
  weekNumber     Int      // ISO week number
  year           Int
  weightKg       Float?
  mealAdherence  Int      @default(0) // 0–7 days followed
  notes          String?
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([userId, weekNumber, year])
  @@index([userId])
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String   // encrypted ciphertext — kept for SMS delivery
  phoneHash String   // HMAC-SHA256 for lookups
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phoneHash])
}
